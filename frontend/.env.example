# Backend REST base URL (no trailing slash). In production: https://<your-api>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
# Backend WebSocket URL. In production use wss://<your-api>.onrender.com/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Optional. Shown on the login screen as a hint for reviewers. Must match the backend's
# FIXED_OTP. This is PUBLIC (baked into the JS bundle); leave it empty to hide the hint.
NEXT_PUBLIC_DEMO_OTP=123456
