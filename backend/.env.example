# SQLite file. Locally defaults to ./signal.db; on Render point it at the persistent disk:
# DATABASE_URL=sqlite:////data/signal.db
DATABASE_URL=sqlite:///./signal.db
# Comma-separated list of allowed browser origins (your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000
# Cloudinary credentials (Dashboard -> API Keys). Uploads are disabled if unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# How long a login session stays valid
SESSION_DAYS=30
# Seed demo data automatically when the users table is empty
AUTO_SEED=true
# REQUIRED. The mocked 6-digit login code every phone number accepts.
FIXED_OTP=123456
